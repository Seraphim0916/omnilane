#!/usr/bin/env bash
set -euo pipefail
# omnilane — global entrypoint so commands work from any directory.

SELF="${BASH_SOURCE[0]}"
# A relative readlink target (how npm links global bins) resolves against the
# symlink's own directory, not the caller's cwd.
while [[ -L "$SELF" ]]; do
  TARGET="$(readlink "$SELF")"
  case "$TARGET" in
    /*) SELF="$TARGET" ;;
    *) SELF="$(dirname "$SELF")/$TARGET" ;;
  esac
done
REPO="$(cd "$(dirname "$SELF")/.." && pwd)"

cmd="${1:-help}"; shift || true
case "$cmd" in
  version|--version|-V)
    [[ -r "$REPO/VERSION" ]] || {
      echo "omnilane: VERSION file is unavailable" >&2
      exit 1
    }
    version="$(<"$REPO/VERSION")"
    [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
      echo "omnilane: invalid VERSION file" >&2
      exit 1
    }
    printf 'omnilane %s\n' "$version"
    ;;
  list)      exec bash "$REPO/scripts/dispatch.sh" --list ;;
  route|dispatch) exec bash "$REPO/scripts/dispatch.sh" "$@" ;;
    jobs)      exec bash "$REPO/scripts/jobs.sh" "$@" ;;
    goal)      exec bash "$REPO/scripts/lib/goal-loop.sh" "$@" ;;
  mcp)
    command -v node >/dev/null 2>&1 || {
      echo "omnilane: mcp requires Node.js on PATH" >&2
      exit 1
    }
    exec node "$REPO/bin/omnilane-mcp" "$@"
    ;;
  completion)
    [[ $# -eq 1 ]] || {
      echo "usage: omnilane completion bash|zsh|fish" >&2
      exit 2
    }
    case "$1" in
      bash) cat "$REPO/completions/omnilane.bash" ;;
      zsh)  cat "$REPO/completions/_omnilane" ;;
      fish) cat "$REPO/completions/omnilane.fish" ;;
      *) echo "usage: omnilane completion bash|zsh|fish" >&2; exit 2 ;;
    esac
    ;;
  release-audit) exec bash "$REPO/scripts/release-audit.sh" "$@" ;;
  doctor)    exec bash "$REPO/scripts/doctor.sh" "$@" ;;
  which-bin)
    [[ "$#" -eq 1 ]] || { echo "usage: omnilane which-bin VENDOR" >&2; exit 2; }
    # shellcheck source=../scripts/lib/common.sh
    source "$REPO/scripts/lib/common.sh"
    binary="$(vendor_bin "$1")"
    [[ -n "$binary" ]] || { echo "omnilane: unknown CLI vendor '$1'" >&2; exit 2; }
    resolved="$(command -v "$binary")" || {
      echo "omnilane: executable not found for '$1': $binary" >&2; exit 1
    }
    [[ -f "$resolved" && -x "$resolved" ]] || {
      echo "omnilane: not an executable file for '$1': $binary" >&2; exit 1
    }
    command -v python3 >/dev/null 2>&1 || {
      echo "omnilane: which-bin requires Python 3.9 or newer" >&2; exit 1
    }
    exec python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$resolved"
    ;;
  whoami)
    command -v python3 >/dev/null 2>&1 || {
      echo "omnilane: whoami requires Python 3.9 or newer" >&2
      exit 1
    }
    exec python3 "$REPO/scripts/lib/caller_identity.py" "$@"
    ;;
  native-context)
    command -v python3 >/dev/null 2>&1 || {
      echo "omnilane: native-context requires Python 3.9 or newer" >&2
      exit 1
    }
    exec python3 "$REPO/scripts/lib/native_context.py" "$@"
    ;;
  resign)
    command -v python3 >/dev/null 2>&1 || {
      echo "omnilane: resign requires Python 3.9 or newer" >&2
      exit 1
    }
    # Python loads dispatch's host configuration and reports any error once.
    exec python3 "$REPO/scripts/lib/resign.py" "$@"
    ;;
  benchmark)
    command -v python3 >/dev/null 2>&1 || {
      echo "omnilane: benchmark requires Python 3.9 or newer" >&2
      exit 1
    }
    exec python3 "$REPO/scripts/benchmark.py" "$@"
    ;;
  ui)
    command -v python3 >/dev/null 2>&1 || {
      echo "omnilane: ui requires Python 3.9 or newer" >&2
      exit 1
    }
    exec python3 "$REPO/scripts/ui.py" "$@"
    ;;
  configure) exec bash "$REPO/scripts/configure.sh" "$@" ;;
  help|--help|-h)
    cat <<'EOF'
omnilane — one routing table, every harness

  omnilane version                      installed release version
  omnilane list                         effective routing table
  omnilane route [--vendor V] [flags] LANE "TASK"
                                        dispatch or consult a model
  omnilane goal open "TEXT" [--budget-jobs N] [--budget-seconds S] [--workdir DIR]
                                        open a goal; budgets default to unlimited
  omnilane goal dispatch GOAL_ID [dispatch.sh args...]
                                         budget-gate and start one background job
                                         --dry-run unsupported; preview with omnilane dispatch --dry-run
  omnilane goal note GOAL_ID "TEXT"       append a timestamped foreman note
  omnilane goal status GOAL_ID           inspect budgets, fuse trips, and recorded jobs
  omnilane goal close GOAL_ID [--summary "TEXT"]
                                         write the final goal report
  omnilane jobs  [--json] COMMAND [ARGS]  list, status, result, stats, recommend, wait, or audit
  omnilane mcp                          start the MCP stdio server
  omnilane completion bash|zsh|fish      print a shell completion script
  omnilane release-audit [flags]          offline, read-only release gate
  omnilane doctor [--json] [--strict] [--probe V]  local health / opt-in live probe
  omnilane which-bin VENDOR              resolved executable dispatch would run (read-only)
  omnilane whoami                       caller-context file for the CLI this runs under
  omnilane native-context [--workdir DIR] [--mode M] [--inherits-caller-runtime]
                                         capability file that lets dispatch use this harness's own sub-agents
                                         (--vendor V --model M: the host's statement when whoami cannot read it)
  omnilane resign [--check] [--vendor V] [--approve V] [--record-signers] [--trust-adhoc V]
                                         re-probe and re-sign the transport overlay after a CLI update
  omnilane benchmark [--json] [--run] [--vendor V] fixed quality/cost comparison
  omnilane ui    start|status|url|stop
  omnilane configure                    interactive lane menu
EOF
    ;;
  *) echo "omnilane: unknown command '$cmd' (try: omnilane help)" >&2; exit 2 ;;
esac
